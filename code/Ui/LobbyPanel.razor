@namespace CitySim
@using CitySim.Match
@using CitySim.Punchboard
@inherits MatchPanel
<root class="center-stage lobby-stage">
 <div class="pb-lobby-layout"><PbPanel Title="CITY LOBBY" Kind=@(PbPanelKind.Raised)><ChildContent><div class="pb-lobby-content">
 <div class="pb-screen-title">Build a city together</div>
 @if (City.Session?.Lobby is { } room) {
 <div>@($"{room.Members.Count(m=>m.Connected && !m.Spectator)} / {room.Capacity} players")</div>
 <div class="pb-lobby-list">@foreach (var p in room.Members.Where(m=>m.Connected)) { <div class="lobby-member pb-lobby-row"><PbMeeple /><div class="pb-lobby-name">@($"{(p.Id==room.Host ? "♛ " : "")}{p.Name}{(p.Id==CityGame.Me ? " · you" : "")}")</div><div>@(p.Spectator ? "👁 Watching" : p.Ready ? "● Ready" : "○ Not ready")</div></div> }</div>
 @if (City.Session.IsHost) { <div>@($"Friends can join with host Steam ID: {City.Session.InviteAddress}")</div> }
 <div class="pb-lobby-actions">@if (room.Members.FirstOrDefault(m=>m.Id==CityGame.Me) is {Spectator:false} own) { <PbButton CssClass="primary" Text=@(own.Ready ? "Not ready" : "Ready") Toggled=@own.Ready Clicked=@(() => { City.Session.ToggleReady(); }) /> } @if (City.Session.IsHost) { <PbButton CssClass="start-match" Text="Start match" Disabled=@(!City.Session.CanStart) Clicked=@(() => { City.Session.StartMatch(); }) /> } <PbButton Text="Leave lobby" Kind=@(PbButtonKind.Ghost) Clicked=@(() => { City.RequestMenu(); }) /></div>
 @if (room.Members.Count(m=>m.Connected && !m.Spectator)<2) { <div>Waiting for at least one more player.</div> } else if (!City.Session.CanStart && City.Session.IsHost) { <div>Waiting for players.</div> }
 } else { <div>Connecting…</div><PbButton Text="Back to menu" Kind=@(PbButtonKind.Ghost) Clicked=@(() => { City.RequestMenu(); }) /> }
 </div></ChildContent></PbPanel></div>
</root>

@code {
	readonly Dictionary<Guid,bool> ready=new();
	readonly Dictionary<Guid,float> pops=new();
	void Changed()
	{
		var changed=false;
		foreach (var m in City.Session.Lobby?.Members ?? Array.Empty<LobbyMember>())
		{
			if (ready.TryGetValue(m.Id,out var previous) && previous!=m.Ready) { pops[m.Id]=0; changed=true; }
			ready[m.Id]=m.Ready;
		}
		if (changed) Sfx.Play("sounds/feedback/chime.sound",City.Player.WorldPosition);
		Refresh();
	}
	protected override void Subscribe() { if (City!=null) City.UiChanged+=Changed; Changed(); }
	protected override void Unsubscribe() { if (City!=null) City.UiChanged-=Changed; }
	public override void Tick()
	{
		base.Tick(); var members=City.Session.Lobby?.Members.Where(m=>m.Connected).ToArray() ?? Array.Empty<LobbyMember>();
		var rows=Descendants.Where(p=>p.HasClass("lobby-member")).ToArray();
		for (var i=0;i<members.Length && i<rows.Length;i++) if (pops.TryGetValue(members[i].Id,out var age))
		{
			age+=Time.Delta; var t=Math.Clamp(age/0.18f,0,1);
			rows[i].Style.Set("transform",FormattableString.Invariant($"scale({1+0.025f*MathF.Sin(t*MathF.PI):0.###})"));
			if (t>=1) pops.Remove(members[i].Id); else pops[members[i].Id]=age;
		}
	}
}
